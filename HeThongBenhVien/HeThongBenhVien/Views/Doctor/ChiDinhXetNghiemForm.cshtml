@model HeThongBenhVien.Models.MedicalRecord
@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewData["Title"] = "Chỉ Định Xét Nghiệm";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-1 text-gray-800" style="font-weight: 700; color: #1e293b;">Chỉ Định Dịch Vụ Cận Lâm Sàng</h2>
            <p class="text-muted mb-0">Tạo phiếu yêu cầu xét nghiệm, siêu âm, X-Quang cho bệnh nhân @(Model?.Appointment?.Patient?.FullName).</p>
        </div>
    </div>

    <form asp-action="LuuChiDinhXetNghiem" asp-controller="Doctor" method="post">
        <input type="hidden" name="id" value="@Model?.Id" />
        <div class="glass-card p-4">
            <div class="row">
                <div class="col-md-6 border-end">
                    <h5 class="fw-bold text-primary mb-4"><i class="fa-solid fa-vials me-2"></i>Xét Nghiệm</h5>
                    
                    <div class="mb-4">
                        <span class="text-uppercase fw-bold text-muted d-block mb-3" style="font-size: 11px; letter-spacing: 0.5px;"><i class="fa-solid fa-droplet text-danger me-1"></i>Xét nghiệm máu</span>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="loaiXetNghiem" value="CBC" id="test1" checked>
                            <label class="form-check-label" for="test1">Công thức máu toàn phần (CBC) - 100,000đ</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="loaiXetNghiem" value="SinhHoa" id="test2" checked>
                            <label class="form-check-label" for="test2">Sinh hóa máu (Đường huyết, Ure, Creatinin) - 200,000đ</label>
                        </div>
                    </div>
                    
                    <div>
                        <span class="text-uppercase fw-bold text-muted d-block mb-3" style="font-size: 11px; letter-spacing: 0.5px;"><i class="fa-solid fa-flask text-warning me-1"></i>Xét nghiệm nước tiểu & Khác</span>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="loaiXetNghiem" value="NuocTieu" id="other1" checked>
                            <label class="form-check-label" for="other1">Tổng phân tích nước tiểu - 50,000đ</label>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <h5 class="fw-bold text-success mb-4"><i class="fa-solid fa-image me-2"></i>Chụp Hình Ảnh</h5>
                    
                    <div class="mb-4">
                        <span class="text-uppercase fw-bold text-muted d-block mb-3" style="font-size: 11px; letter-spacing: 0.5px;"><i class="fa-solid fa-wave-square text-info me-1"></i>Siêu âm</span>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="loaiXetNghiem" value="SieuAm" id="img1">
                            <label class="form-check-label" for="img1">Siêu âm ổ bụng tổng quát - 150,000đ</label>
                        </div>
                    </div>
                    
                    <div>
                        <span class="text-uppercase fw-bold text-muted d-block mb-3" style="font-size: 11px; letter-spacing: 0.5px;"><i class="fa-solid fa-x-ray text-secondary me-1"></i>Chụp X-Quang</span>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="loaiXetNghiem" value="XQuang" id="img2" checked>
                            <label class="form-check-label" for="img2">X-Quang ngực thẳng - 120,000đ</label>
                        </div>
                    </div>
                </div>
            </div>
            <hr class="my-4">
            <div class="d-flex justify-content-between align-items-center">
                <a href="@Url.Action("ChiTietBenhAn", "Doctor", new { id = Model?.Id })" class="btn btn-light px-4 py-2">Quay lại</a>
                <button type="submit" class="btn btn-primary px-5 py-2"><i class="fa-solid fa-paper-plane me-2"></i>Gửi Yêu Cầu</button>
            </div>
        </div>
    </form>
</div>
